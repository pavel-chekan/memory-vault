
APP_NAME=MemoryVault
DEBUG=true

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=memory_vault
POSTGRES_USER=memory_vault
POSTGRES_PASSWORD=change_me

MINIO_ROOT_USER=memory_vault
MINIO_ROOT_PASSWORD=change_this_password

TELEGRAM_BOT_TOKEN=your_bot_token

# Outbox worker
OUTBOX_WORKER_ENABLED=false
OUTBOX_BATCH_SIZE=10
OUTBOX_LEASE_DURATION_SECONDS=60
OUTBOX_POLL_INTERVAL=1.0
# OUTBOX_HEARTBEAT_INTERVAL_SECONDS=20.0   # defaults to lease duration / 3
# OUTBOX_HANDLER_TIMEOUT_SECONDS=30.0      # defaults to no timeout
OUTBOX_SHUTDOWN_TIMEOUT_SECONDS=30.0
